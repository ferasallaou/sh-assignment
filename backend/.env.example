# Copy to .env and fill in.

# Matches docker-compose.yml
DATABASE_URL=postgres://knowledge:knowledge@localhost:5433/knowledge

# Optional. Tests default to the same server with database "knowledge_test".
# TEST_DATABASE_URL=postgres://knowledge:knowledge@localhost:5433/knowledge_test

# Port for the MCP service (npm run mcp)
MCP_PORT=3100

# Port for the web API behind the page (npm run api). The page itself runs on 5173.
API_PORT=3200

# Agent CLI (npm run agent). Defaults: the roadmap agent key, and the MCP service on MCP_PORT.
# AGENT_KEY=dev-agent-roadmap
# MCP_URL=http://127.0.0.1:3100/mcp

# AI models through OpenRouter (https://openrouter.ai). Without a key, search uses keywords only
# and the agent can't run. Changing the embedding model means re-embedding (see README).
OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-5.5
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
