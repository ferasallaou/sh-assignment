{
  "name": "company-knowledge-layer-poc",
  "version": "0.1.0",
  "private": true,
  "description": "PoC of a permission-aware company knowledge layer for AI agents (ShopFully & Flipp take-home).",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend --",
    "sync": "npm run sync -w backend --",
    "mcp": "npm run mcp -w backend --",
    "agent": "npm run agent -w backend --",
    "eval": "npm run eval -w backend --",
    "demo": "npm run demo -w backend --",
    "models:check": "npm run models:check -w backend --",
    "build": "npm run build -w backend --",
    "typecheck": "npm run typecheck -w backend --",
    "test": "npm run test -w backend --",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
