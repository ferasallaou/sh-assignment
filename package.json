{
  "name": "company-knowledge-layer-poc",
  "version": "0.1.0",
  "private": true,
  "description": "PoC of a permission-aware company knowledge layer for AI agents (ShopFully & Flipp take-home).",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync": "tsx scripts/sync.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "test": "jest --runInBand",
    "mcp": "tsx scripts/mcp.ts",
    "models:check": "tsx scripts/check-models.ts",
    "agent": "tsx scripts/agent.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/openai": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  }
}
